function planStdCh6(){
  return '<p><b>（1）访谈：</b>与系统管理员、安全管理员、数据库管理员、网络管理员面对面交流，适用于安全管理制度、机构、人员等管理类指标（如询问密码策略设置）。</p>'+
  '<p><b>（2）核查：</b>上机查看网络设备、安全设备、主机、数据库配置参数；查阅管理制度、运维记录、备份记录等文档；实地查看机房物理环境。</p>'+
  '<p><b>（3）测试：</b>使用 Nessus/OpenVAS 进行漏洞扫描；使用配置核查工具进行基线核查；对应用系统身份鉴别、访问控制等功能进行人工验证。</p>';
}
function planStdCh7(){
  return '<p><span class="pk">现场测评周期：</span>2026 年 9 月 14 日—18 日，共 5 个工作日。</p>'+
  '<table><tr><th>日程</th><th>工作内容</th><th>人员</th></tr>'+
  '<tr><td>第 1 天（周一）</td><td>项目启动会、签署保密协议；物理环境核查、管理文档查阅；人员访谈（管理类）</td><td>全员</td></tr>'+
  '<tr><td>第 2 天（周二）</td><td>网络设备配置核查；安全设备核查</td><td>A 组</td></tr>'+
  '<tr><td>第 3 天（周三）</td><td>主机安全基线核查；数据库安全配置核查</td><td>A 组</td></tr>'+
  '<tr><td>第 4 天（周四）</td><td>应用系统安全功能验证；漏洞扫描</td><td>A/C 组</td></tr>'+
  '<tr><td>第 5 天（周五）</td><td>补充核查；项目总结会；撤离现场</td><td>全员</td></tr></table>'+
  '<p><span class="pk">人员分工：</span>项目经理（总体协调、进度与质量控制）；A 组（技术：物理环境、网络/安全设备、主机、数据库、应用系统）；B 组（管理：制度/机构/人员/建设/运维五类核查与访谈）；C 组（测试：漏洞扫描、配置核查、结果分析）。</p>';
}
function planObjTable(){
  let rows=[["边界防火墙","华为 USG6000","1 台","是","100% 测评（边界防护核心）"],
  ["核心交换机","华为 S12708","2 台","是","100% 测评（堆叠，网络核心）"],
  ["Web 服务器","华为 RH2288（Linux）","3 台","是","抽 2 台（66%，≥30%）"],
  ["应用服务器","华为 RH2288（Linux）","2 台","是","100% 测评（业务核心）"],
  ["数据库服务器","华为 RH2288（Win）","2 台","是","抽 1 台（50%，≥30%）"],
  ["堡垒机","齐治","1 台","是","100% 测评（运维审计核心）"],
  ["日志审计系统","天融信","1 套","是","100% 测评（三级要求）"],
  ["WAF","安恒","1 台","是","100% 测评（Web 防护）"],
  ["办公终端","联想","50 台","否","非核心设备，不纳入"],
  ["打印机","惠普","10 台","否","非信息系统设备，不纳入"]];
  return '<table><tr><th>序号</th><th>设备/系统</th><th>型号</th><th>数量</th><th>是否测评</th><th>抽样说明/理由</th></tr>'+
    rows.map((r,i)=>'<tr><td>'+(i+1)+'</td>'+r.map(c=>'<td>'+c+'</td>').join("")+'</tr>').join("")+'</table>';
}
function planIdxTable(){
  return '<p>本次测评指标依据 GB/T 22239-2019 第三级安全要求确定，涉及安全通用要求 10 个层面（技术 5 + 管理 5）。</p>'+
  '<table><tr><th>层面</th><th>子类数</th><th>说明</th></tr>'+
  '<tr><td>安全物理环境</td><td>10</td><td>全部适用</td></tr>'+
  '<tr><td>安全通信网络</td><td>3</td><td>可信验证 1 项不适用（未部署可信计算模块）</td></tr>'+
  '<tr><td>安全区域边界</td><td>6</td><td>可信验证 1 项不适用（未部署可信计算模块）</td></tr>'+
  '<tr><td>安全计算环境</td><td>11</td><td>34 项中 33 项适用；可信验证不适用（未部署可信计算模块）</td></tr>'+
  '<tr><td>安全管理中心</td><td>4</td><td>全部适用</td></tr>'+
  '<tr><td>安全管理（制度/机构/人员/建设/运维）</td><td>4+5+4+10+14</td><td>全部适用</td></tr></table>'+
  '<p><b>裁剪说明：</b>「可信验证」指标因系统未部署可信计算模块判定不适用，已逐条说明理由；其余指标不得随意裁剪。</p>';
}
function buildPlanDoc(){
  function block(title, inner, fromUser){
    return '<h3>'+title+(fromUser?' <span style="font-size:10px;color:#1E7A4C;border:1px solid #9CC7B0;border-radius:999px;padding:0 8px;vertical-align:middle">▎按你的作答生成</span>':'')+'</h3>'+inner;
  }
  let html='';
  const pi=STEPS.findIndex(function(x){return x.type==="plan";});
  const pr=(pi>=0)?records[pi]:null;
  html+='<h2>网络安全等级保护测评方案</h2>'+
        '<p class="paper-sub">（第三级 · 测评准备阶段成果）</p>'+
        '<p style="text-align:center;font-size:12px;color:#6B6552">项目名称：政务服务中心综合管理平台等保测评<br>委托单位：某市政务服务管理局　测评机构：XX 信息安全测评中心<br>编制日期：2026 年 9 月　版本号：V1.0<br>编制：项目经理'+((pr&&pr.sign)?('（'+esc(pr.sign.name)+'）'):'')+'　审核：＿＿＿＿　批准：＿＿＿＿</p>';
  // 第一章
  const c1a=recText(1), c1b=recText(4);
  let ch1='';
  if(c1a||c1b){ ch1='<p><span class="pk">◆ 项目信息认知：</span><br>'+(c1a||"—")+'</p><p><span class="pk">◆ 定级报告关键信息：</span><br>'+(c1b||"—")+'</p>'; }
  html+=block('第一章　项目概述', ch1||planStdCh1(), !!(c1a||c1b));
  // 第二章
  html+=block('第二章　测评依据','<p>1.《中华人民共和国网络安全法》第二十一条；</p><p>2. GB/T 22239-2019《信息安全技术 网络安全等级保护基本要求》；</p><p>3. GB/T 28448-2019《信息安全技术 网络安全等级保护测评要求》；</p><p>4. GB/T 28449-2018《信息安全技术 网络安全等级保护测评过程指南》；</p><p>5. GB/T 22240-2020《信息安全技术 网络安全等级保护定级指南》；</p><p>6. 《信息系统安全等级保护定级报告》（编号 DJ-2026-0518）及备案证明。</p>',false);
  // 第三章
  const c3=recText(9);
  html+=block('第三章　测评范围', c3?('<p>'+c3+'</p>'):planStdCh3(), !!c3);
  // 第四章
  const c4=recText(10);
  html+=block('第四章　测评对象', planObjTable()+(c4?('<p><span class="pk">◆ 我的选取理由：</span><br>'+c4+'</p>'):'<p><span class="pk">选取原则：</span>应测尽测、关键性、代表性、抽样（同质化设备不低于 30%）。</p>'), !!c4);
  // 第五章
  const c5=recText(11);
  html+=block('第五章　测评指标', planIdxTable()+(c5?('<p><span class="pk">◆ 我的指标确定说明：</span><br>'+c5+'</p>'):''), !!c5);
  // 第六章
  const c6=recText(12);
  html+=block('第六章　测评方法', c6?('<p>'+c6+'</p>'):planStdCh6(), !!c6);
  // 第七章
  const c7=recText(13);
  html+=block('第七章　日程安排与人员分工', c7?('<p>'+c7+'</p><p><span class="pk">◆ 标准日程参考：</span></p>'+planStdCh7()):planStdCh7(), !!c7);
  // 第八章
  const c8=recText(14);
  html+=block('第八章　风险控制', c8?('<p>'+c8+'</p>'):'<p><b>主要风险：</b>①业务中断风险（测评影响系统运行）；②数据泄露风险（接触敏感数据）；③设备故障风险（配置操作失误）；④进度延误风险。</p><p><b>应对措施：</b>①测评操作安排在业务低峰期，漏洞扫描前与客户确认；②全员签署保密协议，测评数据不携带离场，报告脱敏；③配置变更前备份，操作留日志，可紧急恢复；④每日汇总进度，预留缓冲时间。</p>', !!c8);
  if(pr&&pr.sign){
    html+='<h3>方案确认（签字页）</h3>'+
      '<p>本《测评方案》已经过项目经理（项目第一责任人）审阅确认，同意按本方案组织实施本次等级保护测评工作，并对方案内容的完整性与可执行性负责。</p>'+
      '<p><span class="pk">项目经理（第一责任人）签字：</span><span class="sign-name">'+esc(pr.sign.name)+'</span></p>'+
      '<p><span class="pk">签署日期：</span>'+esc(pr.sign.date)+'　　<span class="pk">确认结果：</span>已确认使用本方案</p>';
  }
  html+='<p class="paper-seal">—— 以下无正文 ——</p><p style="text-align:center;font-size:11px;color:#8A6D1F">本方案由「测评指挥官」闯关系统根据你的作答汇编生成，仅供教学练习使用。</p>';
  return html;
}
function onGenPlan(){
  const s=STEPS[current];
  if(!gateNeed(s).ready){toast("请先点击查看全部三张引导卡，阅读完成后才能生成方案");return;}
  const docHtml=buildPlanDoc();
  $("planTitle").textContent="📑 测评方案 · 政务服务中心综合管理平台（V1.0）";
  $("planBody").innerHTML='<div class="paper">'+docHtml+'</div>';
  $("planMask").classList.remove("hidden");
  renderSignConfirm();
}
// ============ 方案签字定稿 ============
function renderSignConfirm(){
  $("planSlot").innerHTML=
    '<div class="sign-box">'+
      '<div class="sg-title">✍️ 方案定稿 · 请项目经理签字确认</div>'+
      '<div class="sg-q">张工：《测评方案》已生成（可点击「查看方案」核对内容）。作为项目经理、项目第一责任人，<b>你是否确认使用该方案？</b>——方案一经签字即定稿，将作为后续现场测评工作的执行依据。</div>'+
      '<div class="sg-btns">'+
        '<button class="btn-ghost2" id="btnSignView">📄 查看方案</button>'+
        '<button class="btn-submit" id="btnSignYes" style="flex:1">✍️ 确认使用，签名定稿</button>'+
        '<button class="btn-ghost" id="btnSignBack">↩️ 返回重新检查方案</button>'+
      '</div>'+
      '<div class="sign-row hidden" id="signRow">'+
        '<input class="sign-input" id="signName" maxlength="20" placeholder="请输入你的姓名进行签署">'+
        '<button class="btn-submit" id="btnSignDo" style="flex:none">签署确认</button>'+
      '</div>'+
    '</div>';
  $("planSlot").classList.remove("hidden");
  $("btnSignView").addEventListener("click",function(){
    $("planTitle").textContent="📑 测评方案 · 政务服务中心综合管理平台（V1.0）";
    $("planBody").innerHTML='<div class="paper">'+buildPlanDoc()+'</div>';
    $("planMask").classList.remove("hidden");
  });
  $("btnSignYes").addEventListener("click",function(){
    $("signRow").classList.remove("hidden");
    $("signName").focus();
    toast("请输入姓名完成电子签署");
  });
  $("signName").addEventListener("keydown",function(e){if(e.key==="Enter")$("btnSignDo").click();});
  $("btnSignDo").addEventListener("click",onSignPlan);
  $("btnSignBack").addEventListener("click",function(){
    $("planTitle").textContent="📑 测评方案 · 政务服务中心综合管理平台（V1.0）";
    $("planBody").innerHTML='<div class="paper">'+buildPlanDoc()+'</div>';
    $("planMask").classList.remove("hidden");
    renderPlanIntro(STEPS[current]);
    toast("已返回：请重新检查方案内容或回看相关步骤，确认后再次生成并签署");
  });
}
function onSignPlan(){
  const name=($("signName").value||"").trim();
  if(!name){toast("请输入姓名后再签署");$("signName").focus();return;}
  const s=STEPS[current];
  if(!gateNeed(s).ready){toast("请先点击查看全部三张引导卡，阅读完成后才能生成方案");return;}
  // 评分：其他已作答步骤中 ≥2 星的比例（兼容自由选关的乱序作答）
  let done=0, total=0;
  for(let i=0;i<STEPS.length;i++){
    if(i===current) continue;
    total++; if(records[i]&&records[i].stars>=2)done++;
  }
  const ratio=total?done/total:0;
  const stars=ratio>=0.8?3:ratio>=0.5?2:1;
  const gain=Math.round(5*ratio);
  if(records[current])score-=records[current].score;
  const d=new Date();
  const dateStr=d.getFullYear()+" 年 "+(d.getMonth()+1)+" 月 "+d.getDate()+" 日";
  records[current]={
    type:"plan",
    stars, score:gain,
    sign:{name:name,date:dateStr},
    verdict:stars===3?"方案优秀":stars===2?"方案良好":"方案待完善",
    comment:stars===3?"张工：方案已签署定稿！你的前置步骤完成质量很高，这份《测评方案》信息完整、依据充分——挑战一收官！":"张工：《测评方案》已由你签字定稿。前置步骤完成度 "+done+"/"+total+"，未达标章节已按标准参考补全。可以回看低星步骤重新作答，再重新生成并签署一版更完整的方案。",
    teach:"完整方案共 9 章：封面、项目概述、测评依据、测评范围、测评对象、测评指标、测评方法、日程安排与人员分工、风险控制。质量自检：封面信息完整、依据列明标准编号、对象清单具体、指标裁剪有理由、方法描述具体、日程合理、分工明确。项目经理作为第一责任人，签字即对方案的完整性与可执行性负责。",
    expect:"一份结构完整、依据充分、可执行可追溯的测评方案，并经项目经理签字确认定稿。",
    answer:"已生成《测评方案》并签字定稿（项目经理："+name+" · 前置步骤完成 "+done+"/"+total+"）"
  };
  score+=gain;
  submitted=true;
  save();
  updateProj();
  $("scoreVal").textContent=score;
  renderMap();
  $("planSlot").innerHTML=
    '<div class="plan-tip"><b style="color:var(--green)">✅ 方案已签字定稿</b>　签署人：<b>'+esc(name)+'</b>　签署日期：'+dateStr+
    '　<button class="btn-ghost2" id="btnPlanSignedView" style="margin-left:8px">📄 查看定稿方案（含签字页）</button></div>';
  $("btnPlanSignedView").addEventListener("click",function(){
    $("planTitle").textContent="📑 测评方案 · 政务服务中心综合管理平台（V1.0 · 已签署）";
    $("planBody").innerHTML='<div class="paper">'+buildPlanDoc()+'</div>';
    $("planMask").classList.remove("hidden");
  });
  renderFeedback(records[current],false);
  toast("签字成功，《测评方案》已定稿 ✍️");
}
function downloadPlan(){
  const docHtml=buildPlanDoc();
  const page='<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><title>测评方案 · 政务服务中心综合管理平台</title>'+
  '<style>body{font-family:"Noto Sans SC","SimSun",Georgia,serif;background:#EFEBE0;color:#26251F;line-height:1.95;font-size:14px}'+
  '.doc{max-width:820px;margin:24px auto;background:#F7F5EF;padding:46px 56px;box-shadow:0 6px 30px rgba(0,0,0,.15)}'+
  '.doc h2{font-size:20px;text-align:center;letter-spacing:.18em;margin-bottom:2px}'+
  '.doc h3{font-size:15px;margin:20px 0 8px;border-left:3px solid #B03A2E;padding-left:9px}'+
  '.doc p{margin:6px 0}.doc ul{margin:6px 0 6px 20px}.doc li{margin:3px 0}'+
  '.doc table{width:100%;border-collapse:collapse;font-size:12px;margin:8px 0}'+
  '.doc th,.doc td{border:1px solid #B9B29A;padding:5px 8px;text-align:left;vertical-align:top}'+
  '.doc th{background:#EAE5D6}.pk{color:#5A5340;font-weight:700}.paper-sub{text-align:center;color:#6B6552;font-size:12px;letter-spacing:.1em;margin-bottom:6px}.paper-seal{text-align:center;color:#6B6552;font-size:11.5px;margin-top:14px}'+
  '@media print{body{background:#fff}.doc{box-shadow:none;margin:0;padding:0}}</style></head><body><div class="doc">'+docHtml+'</div></body></html>';
  const blob=new Blob([page],{type:"text/html;charset=utf-8"});
  const a=document.createElement("a");
  a.href=URL.createObjectURL(blob);
  a.download="测评方案-政务服务中心综合管理平台-等保三级.html";
  document.body.appendChild(a); a.click();
  setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},400);
  toast("方案已下载，可直接打印或提交");
}

function renderStep(){
  const s=STEPS[current];
  const stage=(s.stage!==undefined&&s.stage!==null)?s.stage:LEVELS[levelIdx].stage;
  updateProj();
  $("scNum").textContent=current+1;
  $("scTitle").textContent=s.title;
  const tag=$("scStage"); tag.textContent=STAGES[stage].name; tag.className="tag tag-stage-"+stage;
  $("scScene").textContent=s.scene;
  $("scTask").textContent=s.task;
  $("hintText").textContent=s.hint;
  $("hintText").classList.remove("show");
  $("feedbackSlot").innerHTML="";
  $("stageProg").textContent=`关卡 ${current+1} / ${STEPS.length}`;
  $("stageChip").textContent="当前阶段："+STAGES[stage].name;
  $("stageChip").style.display="inline-flex";
  renderGuideBar(s);
  renderDocBar(s);
  $("scoreVal").textContent=score;
  if(s.type==="table"){
    $("planSlot").classList.add("hidden");
    renderTable(s);
    $("tableSlot").classList.remove("hidden");
    $("answerRow").classList.add("hidden");
    $("btnTableSubmit").classList.remove("hidden");
    $("btnTableSubmit").disabled=false;
  }else if(s.type==="plan"){
    $("tableSlot").classList.add("hidden");
    $("answerRow").classList.add("hidden");
    $("btnTableSubmit").classList.add("hidden");
    renderPlanIntro(s);
  }else{
    $("planSlot").classList.add("hidden");
    $("tableSlot").classList.add("hidden");
    $("answerRow").classList.remove("hidden");
    $("btnTableSubmit").classList.add("hidden");
    $("answerInput").value="";
    $("answerInput").disabled=false;
    $("btnSubmit").disabled=false;
  }
  renderMap();
  gateApply(s);
  if(s.type==="table"){const f=$("tableSlot").querySelector(".tcell"); if(f&&!f.disabled)f.focus();}
  else if(!s.type&&!$("answerInput").disabled){$("answerInput").focus();}
  window.scrollTo({top:0,behavior:"smooth"});
}
function renderFeedback(rec, readOnly){
  const s=STEPS[current];
  renderMap();
  const cls=rec.stars===3?"good":rec.stars===2?"mid":"poor";
  const bookIcon='<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>';
  let cellHtml="";
  if(rec.detail){
    cellHtml=`<table class="tbl-result"><thead><tr><th>表格栏位</th><th>我的填写</th><th>判定</th><th>标准答案</th></tr></thead><tbody>`+
      rec.detail.map(d=>`<tr><td>${esc(d.label)}</td><td class="my-ans">${esc(d.answer||"—")}</td><td class="${d.ok?"ok":"no"}">${d.ok?"✓ 正确":"✗ 修正"}</td><td class="std">${esc(d.expect)}${d.good?"<br><span style='color:#6B8FA8'>"+esc(d.good)+"</span>":""}</td></tr>`).join("")+
      `</tbody></table>`;
  }
  const planBtn = (s.type==="plan") ? '<button class="btn-ghost2" id="btnPlanRe">📑 查看方案</button>' : '';
  $("feedbackSlot").innerHTML=`
  <div class="feedback ${cls}">
    <div class="fb-ai"><div class="ai-ava">张</div><div class="fb-ai-name">项目总监 · 张工 <small>点评</small></div></div>
    <div class="fb-head">
      <span class="stars">${starsHtml(rec.stars)}</span>
      <span class="fb-verdict">${rec.verdict}</span>
      <span class="fb-score">得分 <b>${rec.score}</b> / ${s.base}</span>
    </div>
    <div class="fb-comment">${esc(rec.comment)}
      ${rec.detail?"":"<span class=\"qa\"><b>你的回答：</b>"+esc(rec.answer)+"</span>"}
    </div>
    ${cellHtml}
    <div class="teach-card"><div class="tc-lb">${bookIcon} 知识点讲解</div><p>${rec.teach}</p><p style="color:#8FA7C3;margin-top:6px">参考要点：${rec.expect}</p></div>
    <div class="fb-next">
      <button class="btn-ghost2" id="btnRetry">重新作答</button>
      ${planBtn}
      <button class="btn-next" id="btnNext">${current===STEPS.length-1?"生成交付报告":"下一步 →"}</button>
    </div>
  </div>`;
  $("btnNext").addEventListener("click",()=>{
    if(current===STEPS.length-1){finishLevel();}else{current++;submitted=false;save();renderStep();}
  });
  const pv=$("btnPlanRe");
  if(pv)pv.addEventListener("click",function(){
    $("planTitle").textContent="📑 测评方案 · 政务服务中心综合管理平台（V1.0）";
    $("planBody").innerHTML='<div class="paper">'+buildPlanDoc()+'</div>';
    $("planMask").classList.remove("hidden");
  });
  const retry=$("btnRetry");
  if(retry)retry.addEventListener("click",()=>{
    score-=rec.score; records[current]=null; delete records[current]; submitted=false; save();
    updateProj();
    $("feedbackSlot").innerHTML="";
    if(rec.detail){
      renderTable(s);
      $("tableSlot").classList.remove("hidden");
      $("answerRow").classList.add("hidden");
      $("btnTableSubmit").classList.remove("hidden");$("btnTableSubmit").disabled=false;
      const inputs=$("tableSlot").querySelectorAll(".tcell");
      inputs.forEach((i,ix)=>{i.disabled=false;i.value="";});
      if(inputs[0])inputs[0].focus();
    }else if(s.type==="plan"){
      renderPlanIntro(s);
    }else{
      $("tableSlot").classList.add("hidden");
      $("answerRow").classList.remove("hidden");
      $("btnTableSubmit").classList.add("hidden");
      $("answerInput").value=rec.answer; $("answerInput").disabled=false; $("btnSubmit").disabled=false;
      $("answerInput").focus();
    }
    $("scoreVal").textContent=score;
    renderMap();
    gateApply(s);
  });
  if(readOnly){
    $("answerInput").disabled=true;$("btnSubmit").disabled=true;$("btnTableSubmit").disabled=true;
    if(rec.detail)$("tableSlot").querySelectorAll(".tcell").forEach(i=>i.disabled=true);
  }
  $("scoreVal").textContent=score;
}

// ============ 提交 ============
function onSubmit(){
  const v=$("answerInput").value.trim();
  if(!v){toast("请先输入你的答案再提交");return;}
  const s=STEPS[current];
  if(!gateNeed(s).ready){toast("请先点击查看全部三张引导卡，阅读完成后才能作答");return;}
  const res=evaluate(s,v);
  if(records[current])score-=records[current].score;
  records[current]={answer:v,...res}; score+=res.score; submitted=true;
  save();
  updateProj();
  $("answerInput").disabled=true; $("btnSubmit").disabled=true;
  renderFeedback(records[current],false);
}

// ============ 复盘 ============
function openReview(idx){
  const r=records[idx]; if(!r)return;
  const s=STEPS[idx];
  let cells="";
  if(r.detail){
    cells=`<table class="tbl-result" style="margin-top:8px"><thead><tr><th>表格栏位</th><th>我的填写</th><th>判定</th><th>标准答案</th></tr></thead><tbody>`+
      r.detail.map(d=>`<tr><td>${esc(d.label)}</td><td class="my-ans">${esc(d.answer||"—")}</td><td class="${d.ok?"ok":"no"}">${d.ok?"✓":"✗"}</td><td class="std">${esc(d.expect)}</td></tr>`).join("")+
      `</tbody></table>`;
  }
  $("reviewBody").innerHTML=`
    <div class="rev-item">
      <div class="ri-meta"><span class="stars">${starsHtml(r.stars)}</span><span class="fb-verdict" style="color:${r.stars===3?"#3DDC97":r.stars===2?"#F5B93E":"#F87171"}">${r.verdict}</span><span style="color:#8FA7C3;font-size:12px">得分 ${r.score}/${s.base}</span></div>
      <div class="ri-q">第${idx+1}关 · ${s.title}</div>
      ${cells||`<div class="ri-a"><b style="color:#4CC3FF">你的答案：</b>${esc(r.answer)}</div>`}
      <div class="ri-f"><b style="color:#F5B93E">张工点评：</b>${esc(r.comment)}</div>
      <div class="ri-f" style="margin-top:6px"><b style="color:#2DD4BF">要点：</b>${r.expect}</div>
    </div>
    <div class="modal-actions">
      <button class="btn-ghost" id="btnRevClose">关闭</button>
      <button class="btn-primary" id="btnRevRedo">🔄 重新闯关本关</button>
    </div>`;
  $("reviewMask").classList.remove("hidden");
  const bClose = $("btnRevClose");
  if (bClose) bClose.addEventListener("click", function(){ $("reviewMask").classList.add("hidden"); });
  const bRedo = $("btnRevRedo");
  if (bRedo) bRedo.addEventListener("click", function(){ $("reviewMask").classList.add("hidden"); redoStep(idx); });
}

// ============ 关卡一览：内容说明 + 点击跳转 ============
function stepBrief(s){
  let t = s.scene || s.task || s.expect || "";
  t = String(t).replace(/\s+/g, " ").trim();
  return t.length > 72 ? t.slice(0, 72) + "…" : t;
}
function openStepMap(){
  const lv = LEVELS[levelIdx];
  const TYPE_NAME = { plan: "生成方案", table: "信息填表" };
  let rows = "";
  STEPS.forEach(function(s, i){
    const done = !!records[i];
    const status = done
      ? '<span style="color:var(--green);font-weight:700">✓ 已闯过</span>'
      : (i === current ? '<span style="color:var(--cyan);font-weight:700">▶ 当前</span>' : '<span style="color:var(--dim)">未挑战</span>');
    rows += '<div class="sm-row' + (i === current ? ' cur' : '') + '"' + (done ? ' data-done' : '') + ' data-idx="' + i + '" title="点击跳转到本关">'
      + '<div class="sm-num">' + (i + 1) + '</div>'
      + '<div class="sm-info"><div class="sm-title">第' + (i + 1) + '关 · ' + esc(s.title)
      + (s.type ? '<span class="sm-type">' + (TYPE_NAME[s.type] || s.type) + '</span>' : '')
      + '</div><div class="sm-brief">' + esc(stepBrief(s)) + '</div></div>'
      + '<div class="sm-status">' + status + '</div>'
      + '</div>';
  });
  $("stepMapBody").innerHTML =
    '<div style="font-size:12px;color:var(--dim);margin-bottom:10px">当前大挑战：<b style="color:var(--txt)">' + esc(lv.name) + '</b> · 共 ' + STEPS.length + ' 关。点击任意一行即可前往（已闯过的会先弹出复盘，未闯过的直接进入该关）。</div>'
    + rows
    + '<div class="modal-actions"><button class="btn-ghost" data-close="stepMapMask">关闭</button></div>';
  $("stepMapMask").classList.remove("hidden");
  $("stepMapBody").querySelectorAll("[data-close]").forEach(function(b){
    b.addEventListener("click", function(){ $(b.dataset.close).classList.add("hidden"); });
  });
  $("stepMapBody").querySelectorAll(".sm-row").forEach(function(r){
    r.addEventListener("click", function(){
      const i = +r.dataset.idx;
      $("stepMapMask").classList.add("hidden");
      if (records[i]) { openReview(i); }
      else if (i !== current) { goStep(i); }
    });
  });
}

// ============ 报告 ============
// ============ 通关点评（80 分规则 + 闯关历史对比） ============
function getAttempts(li){
  const slot = saveSlot();
  const a = slot && slot.attempts && slot.attempts[li];
  if (Array.isArray(a) && a.length) return a;
  return Array.isArray(attemptsMem[li]) ? attemptsMem[li] : [];
}
function recordAttempt(pct){
  const rec = {score: score, max: STEPS.length*5, pct: pct, date: Date.now()};
  attemptsMem[levelIdx] = (attemptsMem[levelIdx] || []).concat([rec]);
  if (typeof window.saveProgress !== "function") return;
  try{
    window.saveProgress(function(p){
      if(!p.games) p.games = {};
      if(!p.games[SAVE_KEY]) p.games[SAVE_KEY] = {levels:[], unlockedLevelIdx:0, lastLevelIdx:0, docs:[], updatedAt:0};
      const slot = p.games[SAVE_KEY];
      if(!Array.isArray(slot.attempts)) slot.attempts = [];
      if(!Array.isArray(slot.attempts[levelIdx])) slot.attempts[levelIdx] = [];
      slot.attempts[levelIdx].push(rec);
      slot.updatedAt = Date.now();
      _pg = p;
      return p;
    });
  }catch(e){}
}
function bestPct(li){
  const a = getAttempts(li);
  return a.length ? a.reduce(function(m,x){ return Math.max(m, x.pct||0); }, 0) : 0;
}
function isLevelPassed(li){
  return isLevelCompleted(li) && bestPct(li) >= 80;
}
function finishLevel(){
  const max = STEPS.length*5;
  const pct = Math.min(100, Math.round(score*100/max));
  recordAttempt(pct);
  showLvlDone(pct);
}
function showLvlDone(pct){
  const lv = LEVELS[levelIdx];
  const max = STEPS.length*5;
  const attempts = getAttempts(levelIdx);
  const n = attempts.length;
  const prev = n >= 2 ? attempts[n-2] : null;
  const passed = pct >= 80;
  const hasNext = levelIdx < LEVELS.length - 1;
  const weak = [];
  STEPS.forEach(function(s,i){ const r = records[i]; if (r && r.stars < 2) weak.push(s.title); });

  let cmp = "";
  if (prev){
    const d = pct - (prev.pct||0);
    const bd = d > 0 ? "rgba(61,220,151,.4)" : (d < 0 ? "rgba(248,113,113,.4)" : "var(--line)");
    const bg = d > 0 ? "rgba(61,220,151,.06)" : (d < 0 ? "rgba(248,113,113,.06)" : "rgba(255,255,255,.03)");
    cmp = '<div style="margin:12px 0;padding:12px 14px;border-radius:12px;border:1px solid '+bd+';background:'+bg+'">'+
      '<div style="font-weight:800;font-size:13px;margin-bottom:8px">📊 与上次闯关表现对比（第 '+(n-1)+' 次 → 第 '+n+' 次）</div>'+
      '<table class="kv-table" style="margin:0"><tr><td>本关得分</td><td>'+(prev.score||0)+' / '+max+'</td><td><b>'+score+' / '+max+'</b></td></tr>'+
      '<tr><td>得分率</td><td>'+(prev.pct||0)+'%</td><td><b>'+pct+'%</b></td></tr></table>'+
      '<p style="margin:8px 0 0;font-size:13px;line-height:1.7">'+
      (d>0 ? '张工：这次比上次<b style="color:#3DDC97">提升 '+d+' 个百分点</b>——针对性补强见效了，保持这个复习节奏。'
        : d<0 ? '张工：这次比上次<b style="color:#F87171">下降 '+(-d)+' 个百分点</b>。先回看下面的点评，把低星步骤的「知识点讲解」再过一遍，别急着赶进度。'
        : '张工：与上次持平——说明相关知识点已经稳定掌握，可以把精力放到新的关卡了。')+'</p></div>';
  }

  let cmt;
  if (passed){
    cmt = (n>1 ? '张工：第 '+n+' 次挑战，终于达标了！' : '张工：恭喜通关「'+lv.name+'」！') +
      (weak.length ? '本关还有 '+weak.length+' 个步骤只拿到 1 星'+(hasNext?'，进入下一关之前可以回看它们的点评和讲解。':'，建议回看讲解再巩固一遍。') : '整套流程走得很扎实。') +
      (hasNext ? '下一关「'+LEVELS[levelIdx+1].name+'」已为你解锁。' : '四大挑战全部完成——从接到委托到风险评估，你已经走完整条等保测评链路。');
  }else{
    cmt = '张工：本关得分率 '+pct+'%（通关线 80%），按规则需要重新挑战本关后才能进入下一关。' +
      (weak.length ? '建议重点复习：'+weak.slice(0,3).join('、')+(weak.length>3?' 等 '+weak.length+' 个步骤':'')+'——每一步都有点评和知识点讲解，第二次会顺手得多。' : '') +
      (n>1 ? '这是你第 '+n+' 次挑战，参考上方对比找到退步的环节，重点突破。' : '别灰心，第一次走完全流程本身就是收获。');
  }

  let btns = "";
  if (passed && hasNext){
    btns = '<button class="btn-primary" id="btnLvlNext">🚀 挑战下一关 →</button>'+
           '<button class="btn-ghost" id="btnLvlRetry">🔄 重新挑战本关</button>';
  }else if (passed){
    btns = '<button class="btn-primary" id="btnLvlHome">🏁 返回关卡地图</button>'+
           '<button class="btn-ghost" id="btnLvlRetry">🔄 重新挑战本关</button>';
  }else{
    btns = '<button class="btn-reset" id="btnLvlRetry" style="width:100%">🔄 重新挑战本关（未达 80 分，暂不能进入下一关）</button>';
  }
  btns += '<button class="btn-ghost" id="btnLvlReport" style="width:100%">📋 查看通关报告</button>';

  $("lvlDoneTitle").textContent = passed ? (hasNext ? "本关通关 · 张工点评" : "全部通关 · 张工点评") : "未达通关线 · 张工点评";
  $("lvlDoneBody").innerHTML =
    '<div style="text-align:center;margin:6px 0 2px">'+
      '<div style="font-size:36px;font-weight:900;color:'+(passed?"#3DDC97":"#F87171")+'">'+pct+'<span style="font-size:15px">%</span></div>'+
      '<div style="color:var(--dim);font-size:12.5px">本关得分 '+score+' / '+max+' · 第 '+n+' 次挑战 · 通关线：得分率 80%</div>'+
      '<div style="display:inline-block;margin-top:8px;padding:5px 16px;border-radius:999px;font-weight:800;font-size:13px;border:1px solid '+(passed?"#3DDC97":"#F87171")+';color:'+(passed?"#3DDC97":"#F87171")+'">'+(passed?"✅ 通关成功，下一关已解锁":"⛔ 未达通关线，需重新挑战")+'</div>'+
    '</div>'+cmp+
    '<div class="rank-card" style="margin-top:12px"><div class="rc-lb">项目经理点评（张工）</div><p>'+esc(cmt)+'</p></div>'+
    '<div class="modal-actions" style="flex-direction:column;gap:8px;margin-top:14px">'+btns+'</div>';
  $("lvlDoneMask").classList.remove("hidden");

  const bNext = $("btnLvlNext");
  if (bNext) bNext.addEventListener("click", function(){ $("lvlDoneMask").classList.add("hidden"); goLevel(levelIdx+1); });
  const bHome = $("btnLvlHome");
  if (bHome) bHome.addEventListener("click", function(){
    $("lvlDoneMask").classList.add("hidden");
    $("screen-game").classList.add("hidden");
    $("screen-cover").classList.remove("hidden");
    updateCover();
    window.scrollTo({top:0,behavior:"smooth"});
  });
  $("btnLvlRetry").addEventListener("click", function(){ $("lvlDoneMask").classList.add("hidden"); resetGame(true); });
  $("btnLvlReport").addEventListener("click", function(){ $("lvlDoneMask").classList.add("hidden"); openReport(); });
}

function rankInfo(){
  const pct=score/(STEPS.length*5);
  if(pct>=0.85)return {t:"金牌项目经理 · 等保测评专家",c:"#F5B93E",d:"你已完整掌握本阶段全流程，判定准确、依据规范，具备独立带队开展测评的能力。继续保持严谨细致的职业作风。"};
  if(pct>=0.7)return {t:"银牌项目经理 · 测评骨干",c:"#C0CCDA",d:"本阶段流程已能独立走完，多数判定准确。建议回看 1~2 星步骤，把要点再巩固一遍，向金牌冲刺。"};
  if(pct>=0.55)return {t:"铜牌项目经理 · 入门测评师",c:"#D98B4E",d:"流程框架已建立，但部分关键判定还不够扎实。请打开「工具包」对照复习相关要点，然后重新挑战薄弱步骤。"};
  return {t:"见习项目经理 · 继续深造",c:"#8FA7C3",d:"流程走通了，但知识点掌握还不牢固。建议复习对应课件，再回来重新挑战——每一步都有张工点评和知识点讲解，好好利用。"};
}
function openReport(){
  const rk=rankInfo();
  const lv=LEVELS[levelIdx];
  const st=STAGES[lv.stage];
  let rows="";
  STEPS.forEach((s,i)=>{
    const r=records[i]||{stars:0,score:0,answer:"未作答"};
    rows+=`<tr><td>${i+1}</td><td>${esc(s.title)}</td><td class="st${r.stars}">${r.stars}星</td><td class="mono">${r.score}</td><td title="${esc(r.answer)}">${esc(r.answer.length>40?r.answer.slice(0,40)+"…":r.answer)}</td></tr>`;
  });
  const c3=Object.values(records).filter(r=>r&&r.stars===3).length;
  const c2=Object.values(records).filter(r=>r&&r.stars===2).length;
  const c1=Object.values(records).filter(r=>r&&r.stars===1).length;
  const totalScore = sumAcrossAllLevels();
  const totalSteps = LEVELS.reduce(function(n,l){return n+l.steps.length;},0);
  const finishedLv = LEVELS.filter(function(_,i){return isLevelPassed(i);}).length;
  $("reportBody").innerHTML=`
    <div class="report-hero">
      <span class="rh-badge">闯关通关 · 本关交付</span>
      <div class="rh-title">${esc(lv.name)} · 通关报告</div>
      <div class="rh-sub" id="reportSub"></div>
      <div class="report-score">
        <div class="rs-box g"><div class="n">${c3}</div><div class="l">三星关卡</div></div>
        <div class="rs-box c"><div class="n">${c2}</div><div class="l">两星关卡</div></div>
        <div class="rs-box p"><div class="n">${c1}</div><div class="l">一星关卡</div></div>
        <div class="rs-box"><div class="n">${score}<span style="font-size:13px;color:#8FA7C3"> / ${STEPS.length*5}</span></div><div class="l">本关得分</div></div>
      </div>
      <div style="display:inline-block;margin-top:8px;padding:8px 22px;border:1px solid ${rk.c};border-radius:999px;color:${rk.c};font-weight:800;font-size:15px">${rk.t}</div>
    </div>
    <div class="rank-card">
      <div class="rc-lb">项目经理评语（张工）</div>
      <p>${rk.d}</p>
    </div>
    <h4>闯关全景</h4>
    <table class="kv-table">
      <tr><td>关卡主题</td><td><b style="color:${st.color}">大关 ${levelIdx+1} / ${LEVELS.length} · ${esc(lv.name)}</b></td></tr>
      <tr><td>本关步骤</td><td>${STEPS.length} 步</td></tr>
      <tr><td>当前进度</td><td>已完成 ${finishedLv} / ${LEVELS.length} 大关卡；累计得分 ${totalScore} / ${totalSteps*5}</td></tr>
      <tr><td>对应课程</td><td>${esc(lv.desc)}</td></tr>
      <tr><td>测评依据</td><td>GB/T 22239-2019、GB/T 28448-2019、GB/T 28449-2018</td></tr>
    </table>
    <h4>本关各步骤作答明细</h4>
    <table class="report-table">
      <tr><th>步</th><th>步骤名称</th><th>星级</th><th>得分</th><th>我的答案</th></tr>
      ${rows}
    </table>
    <h4>知识要点回顾</h4>
    <div class="teach-card">
      <p>· 等保五步走：定级 → 备案 → 建设整改 → 等级测评 → 监督检查；测评机构承担第 4 步。</p>
      <p>· 测评四阶段：测评准备 → 方案编制 → 现场测评 → 报告编制。</p>
      <p>· 定级口诀：先定对象 · 再评 S/A · 取高者 · 专家审 · 报备案；S 看数据、A 看服务，最终等级 = max(S,A)。</p>
      <p>· 方案六步法：解读定级报告 → 分析架构 → 确定范围 → 选取对象 → 确定指标 → 编制方案。</p>
      <p>· 对象四原则：应测尽测、关键性、代表性、抽样（≥30%）；方法三要素：访谈、核查、测试。</p>
      <p>· 报告三核心：单项判定（符合/不符合/部分符合/不适用）、整体结论、整改建议；三级审核后交付。</p>
    </div>
    <div class="modal-actions">
      <button class="btn-primary" id="btnCopyReport">复制报告文本</button>
      <button class="btn-ghost" data-close="reportMask">关闭</button>
      <button class="btn-reset" id="btnRestart">重新挑战本关</button>
    </div>`;
  $("reportMask").classList.remove("hidden");
  $("reportSub").textContent=esc(lv.name)+" · 大关卡 "+(levelIdx+1)+"/"+LEVELS.length;
  $("btnCopyReport").addEventListener("click",copyReport);
  $("btnRestart").addEventListener("click",resetGame);
}
function copyReport(){
  const rk=rankInfo();
  const lv=LEVELS[levelIdx];
  let lines=[
    "【等保测评流程闯关 · 通关报告】",
    "大关卡："+(levelIdx+1)+"/"+LEVELS.length+" · "+lv.name,
    "",
    "本关各步成绩："
  ];
  STEPS.forEach((s,i)=>{
    const r=records[i]||{stars:0,score:0,answer:"未作答"};
    lines.push(`${i+1}. ${s.title} — ${r.stars}星（${r.score}分）— ${r.answer}`);
  });
  lines.push(
    "",
    "本关得分："+score+"/"+(STEPS.length*5),
    "累计大关："+LEVELS.filter(function(_,i){return isLevelPassed(i);}).length+"/"+LEVELS.length,
    "评级："+rk.t
  );
  const txt=lines.join("\n");
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(()=>toast("报告文本已复制到剪贴板")).catch(()=>fallbackCopy(txt));
  }else{fallbackCopy(txt);}
}
function fallbackCopy(txt){
  const ta=document.createElement("textarea");
  ta.value=txt; ta.style.position="fixed"; ta.style.opacity="0";
  document.body.appendChild(ta); ta.select();
  try{document.execCommand("copy");toast("报告文本已复制到剪贴板");}catch(e){toast("复制失败，请手动选择文本");}
  document.body.removeChild(ta);
}

// ============ 持久化 ============
let _pg = null;
const SAVE_KEY = 'denbao-pm-flow2';
function readyProgress(cb) {
  const go = function () {
    if (typeof window.loadProgress === "function") {
      window.loadProgress(true).then(function (p) { _pg = p || null; if (cb) cb(_pg); });
    } else {
      _pg = null; if (cb) cb(_pg);
    }
  };
  if (typeof initIdentity === "function") initIdentity().then(go); else go();
}
function saveSlot() {
  return (_pg && _pg.games && _pg.games[SAVE_KEY]) ? _pg.games[SAVE_KEY] : null;
}
function save() {
  if (typeof window.saveProgress !== "function") return;
  try {
    window.saveProgress(function (p) {
      if (!p.games) p.games = {};
      if (!p.games[SAVE_KEY]) p.games[SAVE_KEY] = { levels: [], unlockedLevelIdx: 0, lastLevelIdx: 0, docs: [], updatedAt: 0 };
      const slot = p.games[SAVE_KEY];
      slot.levels[levelIdx] = {
        current: current,
        score: score || 0,
        submitted: !!submitted,
        records: records || {},
        completed: isLevelCompleted(levelIdx),
        updatedAt: Date.now()
      };
      slot.unlockedLevelIdx = Math.max(slot.unlockedLevelIdx || 0, unlockedLevelIdx);
      slot.lastLevelIdx = levelIdx;
      slot.docs = Object.keys(matUnlocked);
      slot.guideRead = guideRead;
      slot.updatedAt = Date.now();
      _pg = p;
      return p;
    });
  } catch (e) { /* noop */ }
}
function removeLevelSave(li) {
  if (typeof window.saveProgress !== "function") return;
  try {
    window.saveProgress(function (p) {
      if (p.games && p.games[SAVE_KEY] && p.games[SAVE_KEY].levels) {
        p.games[SAVE_KEY].levels[li] = null;
      }
      _pg = p;
      return p;
    });
  } catch (e) { }
}
function isLevelCompleted(li) {
  if (li < 0 || li >= LEVELS.length) return false;
  const slot = saveSlot();
  const lv = slot && slot.levels && slot.levels[li];
  if (!lv || typeof lv.current !== "number") return false;
  const steps = LEVELS[li].steps;
  return lv.current >= steps.length - 1 && !!lv.submitted;
}
function loadSave() {
  if (!_pg) return false;
  try {
    const slot = saveSlot();
    const lv = slot && slot.levels && slot.levels[levelIdx];
    if (slot && Array.isArray(slot.docs)) {
      slot.docs.forEach(function(id){ matUnlocked[id]=true; });
    }
    if (slot && slot.guideRead) guideRead = slot.guideRead;
    if (!lv || typeof lv.current !== "number") return false;
    current = Math.min(lv.current, STEPS.length - 1);
    score = lv.score || 0;
    submitted = !!lv.submitted;
    records = lv.records || {};
    return true;
  } catch (e) { return false; }
}
function syncUnlockedFromSave() {
  const slot = saveSlot();
  if (!slot) return;
  unlockedLevelIdx = Math.max(0, slot.unlockedLevelIdx || 0);
  for (let i = 0; i < LEVELS.length - 1; i++) {
    if (isLevelPassed(i)) unlockedLevelIdx = Math.max(unlockedLevelIdx, i + 1);
  }
}
function updateProj(){
  const l = LEVELS[levelIdx];
  $("projName").textContent = l.name;
  $("projSub").textContent = "等保测评项目 · 第 " + (levelIdx + 1) + " / " + LEVELS.length + " 大关卡";
}
function updateToolkit(){
  let html = "<li>本项目共 <b>" + LEVELS.length + "</b> 大关卡，每关对应课程一大阶段；</li>";
  html += "<li>大挑战之间串行解锁：完成当前大关卡所有步骤后可解锁下一关；</li>";
  html += "<li>本大挑战内的关卡可任意选择，无需按顺序；点击 ✓ 已闯过的关卡可复盘或重新闯关；</li>";
  html += "<li>当前关卡：" + LEVELS[levelIdx].name + "</li>";
  html += "<li>张工发放的材料可在「📁 材料库」随时查看。</li>";
  $("tkCaseList").innerHTML = html;
}
function sumAcrossAllLevels(){
  const slot = saveSlot();
  if (!slot || !slot.levels) return 0;
  let total = 0;
  slot.levels.forEach(function(lv){ if (lv && lv.score) total += lv.score; });
  return total;
}
function renderLevelCards(){
  const grid = $("levelGrid");
  if (!grid) return;
  grid.innerHTML = "";
  syncUnlockedFromSave();
  LEVELS.forEach(function(lv, i){
    const slot = saveSlot();
    const lvSlot = slot && slot.levels && slot.levels[i];
    const done = isLevelPassed(i);
    const tried = isLevelCompleted(i);
    const unlocked = i <= unlockedLevelIdx;
    const prog = (lvSlot && typeof lvSlot.current === "number") ? (lvSlot.current + 1) : 0;
    const total = lv.steps.length;
    const pct = Math.min(100, Math.round(100 * prog / total));
    let cardCls = "level-card";
    if (done) cardCls += " done";
    else if (unlocked && i === unlockedLevelIdx && lvSlot && prog > 0) cardCls += " cur";
    if (!unlocked) cardCls += " locked";
    const card = document.createElement("div");
    card.className = cardCls;
    card.style.setProperty("--lc-color", STAGES[lv.stage].color);
    let statusCls = "locked", statusText = "未解锁";
    if (done) { statusCls = "done"; statusText = "已通关"; }
    else if (tried) { statusCls = "cur"; statusText = "未达 80 分"; }
    else if (unlocked && lvSlot && prog > 0) { statusCls = "cur"; statusText = "进行中"; }
    else if (unlocked) { statusCls = "unlocked"; statusText = "可挑战"; }
    let btnLabel = "🔒 未解锁", btnDisabled = true;
    if (done) { btnLabel = "复盘本关"; btnDisabled = false; }
    else if (tried) { btnLabel = "重新挑战"; btnDisabled = false; }
    else if (unlocked && lvSlot && prog > 0) { btnLabel = "继续闯关"; btnDisabled = false; }
    else if (unlocked) { btnLabel = "开始挑战"; btnDisabled = false; }
    card.innerHTML =
      '<div class="lc-head">' +
          '<span class="lc-num">' + (i + 1) + '</span>' +
          '<span class="lc-name">' + esc(lv.name) + '</span>' +
          '<span class="lc-status ' + statusCls + '">' + statusText + '</span>' +
        '</div>' +
        '<div class="lc-desc">' + esc(lv.desc) + '</div>' +
        '<div class="lc-foot">' +
          '<span>本关 ' + prog + ' / ' + total + ' 步</span>' +
          '<span class="lc-bar"><span style="width:' + pct + '%"></span></span>' +
        '</div>' +
        '<div class="lc-action">' +
          (unlocked
            ? (done
                ? '<button class="lc-btn" data-go="' + i + '">复盘本关</button>' +
                  '<button class="lc-btn ghost" data-redo="' + i + '">🔄 重新闯关</button>'
                : '<button class="lc-btn" data-go="' + i + '"' + (btnDisabled ? ' disabled' : '') + '>' + btnLabel + '</button>')
            : '<button class="lc-btn" disabled>🔒 未解锁</button>') +
        '</div>';
    grid.appendChild(card);
  });
  grid.querySelectorAll("[data-go]").forEach(function(b){
    b.addEventListener("click", function(e){
      e.stopPropagation();
      goLevel(+b.dataset.go);
    });
  });
  grid.querySelectorAll("[data-redo]").forEach(function(b){
    b.addEventListener("click", function(e){
      e.stopPropagation();
      resetLevel(+b.dataset.redo, false, true);
    });
  });
}
function goLevel(i){
  if (i < 0 || i >= LEVELS.length) return;
  syncUnlockedFromSave();
  if (i > unlockedLevelIdx) {
    toast("该关卡尚未解锁，请先通关上一关");
    return;
  }
  levelIdx = i;
  STEPS = buildSteps(LEVELS[levelIdx]);
  submitted = false;
  if (!loadSave()) { current = 0; score = 0; records = {}; }
  else if (isLevelCompleted(levelIdx) && !isLevelPassed(levelIdx)) {
    // 已走完但未达 80 分的关卡：进入即重新挑战；
    // 已通关（≥80 分）的关卡：保留作答记录直接进入，可点击关卡圆点查看复盘、按需重新闯关
    current = 0; score = 0; records = {};
  }
  renderMatDrawer();
  $("screen-cover").classList.add("hidden");
  $("screen-game").classList.remove("hidden");
  renderStep();
  if (submitted && records[current]) renderFeedback(records[current], true);
  window.scrollTo({top:0, behavior:"smooth"});
}
function updateCover(){
  syncUnlockedFromSave();
  renderLevelCards();
  updateProj();
  updateToolkit();
  renderMatDrawer();
}
function enterCase(){
  syncUnlockedFromSave();
  let target = 0;
  for (let i = 0; i < LEVELS.length; i++) {
    if (!isLevelPassed(i)) { target = i; break; }
    target = i + 1;
  }
  if (target >= LEVELS.length) target = LEVELS.length - 1;
  goLevel(target);
}
// 重置任意大挑战（供关卡卡片"重新闯关"使用）：清除该关作答，随后可直接进入
function resetLevel(li, skipConfirm, enterAfter){
  if (li < 0 || li >= LEVELS.length) return;
  const lv = LEVELS[li];
  if (!skipConfirm && !confirm("确定要重新挑战「" + lv.name + "」吗？将清除该关所有作答记录与得分，重新闯关通过后才会再次解锁后续关卡。")) return;
  if (_pg && _pg.games && _pg.games[SAVE_KEY]) {
    _pg.games[SAVE_KEY].levels[li] = null;
    _pg.games[SAVE_KEY].unlockedLevelIdx = Math.min(_pg.games[SAVE_KEY].unlockedLevelIdx || 0, li);
    _pg.games[SAVE_KEY].updatedAt = Date.now();
    try { window.saveProgress(function(p){return p;}); } catch(e){}
  }
  unlockedLevelIdx = Math.min(unlockedLevelIdx || 0, li);
  renderLevelCards();
  toast("已重置「" + lv.name + "」，" + (enterAfter ? "开始重新闯关" : "可随时重新开始"));
  if (enterAfter) goLevel(li);
}
function resetGame(skipConfirm){
  const lv = LEVELS[levelIdx];
  if (!skipConfirm && !confirm("确定要重新挑战「" + lv.name + "」吗？将清除该关所有作答记录与得分，本关之前的「通关」标记撤销，后续关卡暂时锁定。")) return;
  if (_pg && _pg.games && _pg.games[SAVE_KEY]) {
    _pg.games[SAVE_KEY].levels[levelIdx] = null;
    unlockedLevelIdx = Math.min(unlockedLevelIdx || 0, levelIdx);
    _pg.games[SAVE_KEY].unlockedLevelIdx = unlockedLevelIdx;
    _pg.games[SAVE_KEY].updatedAt = Date.now();
    try { window.saveProgress(function(p){return p;}); } catch(e){}
  }
  current = 0; score = 0; submitted = false; records = {};
  $("reportMask").classList.add("hidden");
  $("reviewMask").classList.add("hidden");
  $("stepMapMask").classList.add("hidden");
  $("lvlDoneMask").classList.add("hidden");
  $("screen-game").classList.add("hidden");
  $("screen-cover").classList.remove("hidden");
  renderLevelCards();
  toast("已重置「" + lv.name + "」，通关状态与下一关解锁已撤销。");
  window.scrollTo({top:0, behavior:"smooth"});
}

// ============ 事件绑定 ============
function backToCourse(){
  location.href = "../../index.html";
}
function backToLevelHome(){
  save();
  ["planMask","reportMask","reviewMask","lvlDoneMask","stepMapMask"].forEach(function(id){
    const el=$(id); if(el) el.classList.add("hidden");
  });
  const mat=$("matDrawer"); if(mat) mat.classList.add("hidden");
  const tk=$("toolkit"); if(tk) tk.classList.add("hidden");
  $("screen-game").classList.add("hidden");
  $("screen-cover").classList.remove("hidden");
  updateCover();
  toast("已返回闯关首页，本关进度已自动保存");
  window.scrollTo({top:0,behavior:"smooth"});
}
function bind(){
  $("btnStart").addEventListener("click", enterCase);
  $("btnBackCourse").addEventListener("click", backToCourse);
  $("btnBackTop").addEventListener("click", backToCourse);
  $("btnLvlMap").addEventListener("click", backToLevelHome);
  $("btnHow").addEventListener("click", function(){ $("coverHelp").classList.toggle("hidden"); });
  $("btnHint").addEventListener("click", function(){ $("hintText").classList.toggle("show"); });
  $("btnSubmit").addEventListener("click", onSubmit);
  $("btnTableSubmit").addEventListener("click", onSubmitTable);
  $("answerInput").addEventListener("keydown", function(e){ if ((e.ctrlKey || e.metaKey) && e.key === "Enter") onSubmit(); });
  $("btnReset").addEventListener("click", resetGame);
  $("btnMat").addEventListener("click", function(){
    $("matDrawer").classList.toggle("hidden");
    renderMatDrawer();
  });
  $("matClose").addEventListener("click", function(){ $("matDrawer").classList.add("hidden"); });
  $("btnPlanDownload").addEventListener("click", downloadPlan);
  $("toolkitToggle").addEventListener("click", function(){ $("toolkit").classList.toggle("hidden"); });
  $("toolkitClose").addEventListener("click", function(){ $("toolkit").classList.add("hidden"); });
  document.querySelectorAll("[data-close]").forEach(function(b){
    b.addEventListener("click", function(){ $(b.dataset.close).classList.add("hidden"); });
  });
  ["reviewMask","reportMask","docMask","planMask","lvlDoneMask","stepMapMask"].forEach(function(m){
    const el=$(m);
    if(el)el.addEventListener("click", function(e){ if (e.target === el) el.classList.add("hidden"); });
  });
}
document.addEventListener("DOMContentLoaded", function(){
  bind();
  readyProgress(function(){
    syncUnlockedFromSave();
    renderLevelCards();
    renderMatDrawer();
    updateToolkit();
    if (!$("screen-game").classList.contains("hidden")) return;
    const slot = saveSlot();
    const lastLi = (slot && typeof slot.lastLevelIdx === "number") ? slot.lastLevelIdx : 0;
    if (slot && lastLi <= unlockedLevelIdx && !isLevelCompleted(lastLi) && slot.levels && slot.levels[lastLi] && typeof slot.levels[lastLi].current === "number") {
      levelIdx = lastLi;
      STEPS = buildSteps(LEVELS[levelIdx]);
      if (loadSave()) {
        renderMatDrawer();
        $("screen-cover").classList.add("hidden");
        $("screen-game").classList.remove("hidden");
        renderStep();
        if (submitted && records[current]) renderFeedback(records[current], true);
      }
    }
  });
});
</script>
</body>
</html>
