  }
];
</script>
<script>
// ============ 关卡构建 ============
function buildSteps(level){
  const sid = level.stage;
  const t = GUIDE_TEMPLATES[sid] || {};
  return (level.steps || []).map(function(s){
    let r = (s.stage !== undefined && s.stage !== null) ? s : Object.assign({}, s, {stage: sid});
    if (!r.aiGuide && t.aiGuide) r.aiGuide = t.aiGuide;
    if (!r.mustManual && t.mustManual) r.mustManual = t.mustManual;
    if (!r.quality && t.quality) r.quality = t.quality;
    return r;
  });
}

// ============ 三色引导：AI可帮 / 人工必做 / 行业素养 ============
const GUIDE_TEMPLATES = {
  0: {
    aiGuide: "AI 可帮你快速检索 GB/T 22239-2019 / GB/T 28448-2019 等标准条款、整理测评方案模板、起草文档段落；但标准号、条款编号、定级依据必须以官方原文为准。",
    mustManual: "项目范围、等级判定、测评对象界定——由测评师基于备案证明和客户访谈人工确认并签字，不可全部交由 AI 决定；这是测评活动的法律起点。",
    quality: "熟悉等保 2.0 标准体系、具备方案编写经验；保持严谨细致、与客户和监管的有效沟通能力；所有对外结论都要留痕可追溯。"
  },
  1: {
    aiGuide: "AI 可辅助解读配置文件片段、生成基线检查脚本草稿、归类漏洞扫描结果；但终端实操、现场访谈、业务流程访谈仍需人工完成。",
    mustManual: "现场拍照取证、物理安全观察、人员访谈判定、复杂业务场景的安全判定——都由测评师现场完成并签字留痕；AI 仅作助手。",
    quality: "具备网络安全工程师/渗透测试工程师资质底子；熟悉主流设备配置与基线；保持客观、不被客户引导；记录完整、可复现。"
  },
  2: {
    aiGuide: "AI 可辅助生成报告模板、整理测评数据、自动校验结论一致性；但单项判定的逻辑、整改建议的优先级必须人工把控。",
    mustManual: "单项判定（符合/部分/不符合）、整体结论（优/良/中/差）、整改建议（高/中/低）由测评师基于现场数据人工判定；交付前完成三级审核（编制-审核-批准）。",
    quality: "持测评师证书；文字严谨、客观、可追溯；具备法律风险意识；交付前的三级审核是质量底线，不可省。"
  },
  3: {
    aiGuide: "AI 可辅助梳理云/移动/物联网/工控架构差异、生成风险矩阵草稿、自动计算风险值；但资产识别、威胁赋值、脆弱性赋值仍需评估师人工评定。",
    mustManual: "资产 CIA 赋值、威胁赋值、脆弱性赋值、风险等级判定——都需结合业务场景由评估师人工赋值，并留存评估记录；不可全权委托 AI。",
    quality: "熟悉 GB/T 20984-2022 风险评估方法；对扩展场景（云/移动/物联网/工控）有体系化认知；能独立出具评估报告。"
  }
};
const GUIDE_ICONS = {
  ai: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="9"/><path d="M9 9.5h.01M15 9.5h.01M8 14c1.2 1 2.6 1.5 4 1.5s2.8-.5 4-1.5"/></svg>',
  manual: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg>',
  quality: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2l9 4-9 4-9-4 9-4z"/><path d="M3 12l9 4 9-4"/><path d="M3 17l9 4 9-4"/></svg>'
};

// ============ 状态 ============
let levelIdx = 0;
let STEPS = buildSteps(LEVELS[0]);
let current = 0;
let score = 0;
let submitted = false;
let records = {};                 // idx -> {answer/stars/score/...}
let matUnlocked = {};             // docId -> true
let guideRead = {};               // stepId -> {ai,manual,quality} 三色卡阅读状态
let attemptsMem = {};             // levelIdx -> [{score,max,pct,date}] 闯关历史（未登录时的内存兜底）
let unlockedLevelIdx = 0;
const $ = id => document.getElementById(id);

// ============ 工具函数 ============
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}
function starsHtml(n){
  let h="";
  for(let i=1;i<=3;i++){ h += i<=n ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>' : '<svg class="off" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>'; }
  return h;
}
function toast(msg){const t=$("toast");t.textContent=msg;t.classList.add("show");clearTimeout(t._h);t._h=setTimeout(()=>t.classList.remove("show"),2200);}
function norm(s){return s.toLowerCase();}
function groupRatio(groups, text){
  groups = groups || [];
  let hit=0;
  groups.forEach(g=>{ if(g.some(k=>text.includes(k))) hit++; });
  return groups.length? hit/groups.length : 0;
}
const CN={一:1,二:2,三:3,四:4,五:5};
function parseLevels(t){
  let s=null,a=null,level=null;
  const t0=t.replace(/[，。、：:；;　\s]/g,"");
  const mSA=t0.match(/[sS][=＝]?\s*([1-5])[aA][=＝]?\s*([1-5])/);
  if(mSA){s=+mSA[1];a=+mSA[2];level=Math.max(s,a);}
  const mS=t0.match(/[sS][=＝]?\s*([1-5])/);
  if(mS&&s===null)s=+mS[1];
  const mA=t0.match(/[aA][=＝]?\s*([1-5])/);
  if(mA&&a===null)a=+mA[1];
  const mL=t0.match(/([1-5])\s*级/);
  if(mL)level=+mL[1];
  if(level===null&&s===null&&a===null){
    const mn=t0.match(/(^|[^\d])([1-5])([^\d]|$)/);
    if(mn)level=+mn[2];
  }
  const mcn=t0.match(/[一二三四五]级/);
  if(mcn&&level===null)level=CN[mcn[0][0]];
  return {s,a,level};
}
function confusionNote(custom, v){
  if(custom==="S" && /服务|中断|停摆|宕机|瘫痪|无法办理/.test(v) && !/数据|泄露|篡改|破坏|被盗/.test(v)){
    return "注意：你似乎在用「服务中断」来解释 S —— S 看数据、A 看服务，不要把两个要素搞混。";
  }
  if(custom==="A" && /数据|泄露|篡改|破坏|被盗/.test(v) && !/服务|中断|停摆|瘫痪|无法办理|停摆/.test(v)){
    return "注意：你似乎在用「数据出事」来解释 A —— A 看服务、S 看数据，不要把两个要素搞混。";
  }
  return "";
}

// ============ 评分引擎 ============
function evaluate(s, v){
  const text=norm(v);
  if(s.custom){
    const p=parseLevels(v);
    const lv = s.custom==="S" ? (p.s!==null?p.s:p.level) : s.custom==="A" ? (p.a!==null?p.a:p.level) : p.level;
    const ok = lv===s.expectedLevel;
    const ratio=groupRatio(s.groups,text);
    const conf=confusionNote(s.custom,v);
    let stars,score,verdict,comment;
    if(lv===null||lv===undefined){
      stars=1; score=Math.min(5,Math.round(1.5+1.5*ratio)); verdict="需要重读判定";
      comment="没有读到明确的等级数字。请按「S=? 级 / A=? 级 / 第X级（S?A?）」的格式作答，并写出理由。"+(conf?" "+conf:"");
    }else if(ok&&ratio>=0.6){
      stars=3; score=Math.min(5,Math.round(3+2*ratio)); verdict="判定优秀"; comment=s.good+(conf?" "+conf:"");
    }else if(ok){
      stars=2; score=Math.min(5,Math.round(3+2*ratio)); verdict="判定良好"; comment=s.mid+(conf?" "+conf:"");
    }else{
      stars=1; score=Math.min(5,Math.round(1.5+1.5*ratio)); verdict="判定有误"; comment=s.poor+(conf?" "+conf:"");
    }
    return {stars,score,verdict,comment,teach:s.teach,expect:s.expect};
  }
  const ratio=groupRatio(s.groups||[],text);
  const stars=ratio>=0.75?3:ratio>=0.5?2:1;
  let score=Math.round((s.base||5)*ratio);
  if(s.bonus){
    const bn=s.bonus.filter(g=>g.some(k=>text.includes(k))).length;
    score=Math.min(s.base,score+bn);
  }
  const verdict=stars===3?"判定优秀":stars===2?"判定良好":"需加强";
  const comment=stars===3?s.good:stars===2?s.mid:s.poor;
  return {stars,score,verdict,comment,teach:s.teach,expect:s.expect};
}

// ============ 材料库 ============
function unlockDocs(ids){
  let fresh=[];
  (ids||[]).forEach(function(id){
    if(DOCS[id] && !matUnlocked[id]){ matUnlocked[id]=true; fresh.push(id); }
  });
  if(fresh.length){ save(); renderMatDrawer(); }
  return fresh;
}
function renderDocBar(s){
  const bar=$("docBar");
  if(!s.docs || !s.docs.length){ bar.classList.add("hidden"); bar.innerHTML=""; return; }
  unlockDocs(s.docs);
  let html='<div class="db-lb">📎 张工已发放材料</div>';
  s.docs.forEach(function(id){
    const d=DOCS[id]; if(!d)return;
    html+='<button class="doc-chip" data-doc="'+id+'"><span class="dc-ic">'+d.icon+'</span>'+esc(d.name)+'<span class="dc-new">点击查看</span></button>';
  });
  bar.innerHTML=html;
  bar.classList.remove("hidden");
  bar.querySelectorAll("[data-doc]").forEach(function(b){
    b.addEventListener("click",function(){ openDoc(b.dataset.doc); });
  });
}
function renderMatDrawer(){
  const list=$("matList"); if(!list)return;
  const order=["weituo","xitong","dengji","tuopu","jifang","loudong"];
  let html="";
  order.forEach(function(id){
    const d=DOCS[id]; if(!d)return;
    const un=!!matUnlocked[id];
    html+='<div class="mat-card'+(un?"":" locked")+'" data-doc="'+(un?id:"")+'">'+
      '<div class="mat-ic">'+(un?d.icon:"🔒")+'</div>'+
      '<div class="mat-info"><div class="mat-name">'+esc(d.name)+'</div><div class="mat-meta">'+esc(un?d.meta:"完成对应关卡步骤后由张工发放")+'</div></div>'+
    '</div>';
  });
  // 标准规范原文（对全部学生开放，点击新标签页打开 PDF）
  const stds=[
    {n:"GB/T 22239-2019 网络安全等级保护基本要求", f:"standards/GBT22239-2019.pdf", d:"定「做到什么」——测评指标选取的直接依据"},
    {n:"GB/T 28448-2019 网络安全等级保护测评要求", f:"standards/GBT28448-2019.pdf", d:"定「怎么测」——测评实施与判定的依据"},
    {n:"GB/T 22240-2020 网络安全等级保护定级指南", f:"standards/GBT22240-2020.pdf", d:"定级对象识别、S/A 赋值方法"},
    {n:"GB/T 20984-2022 信息安全风险评估方法", f:"standards/GBT20984-2022.pdf", d:"资产/威胁/脆弱性识别与风险计算"},
    {n:"《中华人民共和国网络安全法》", f:"standards/cybersecurity-law.pdf", d:"第二十一条：等级保护制度的法律依据"},
    {n:"《中华人民共和国数据安全法》", f:"standards/data-security-law.pdf", d:"数据分类分级与安全保护义务"},
    {n:"网络安全等级保护测评报告模板（2025 版）", f:"standards/report-template-2025.pdf", d:"报告结构与单项判定写法参考"}
  ];
  html+='<div class="std-sec"><div class="std-title">📖 标准规范原文</div><div class="std-note">点击在新窗口打开 PDF，答题前可随时查阅</div>'+
    stds.map(function(s){
      return '<a class="std-link" href="'+s.f+'" target="_blank" rel="noopener"><span class="std-ic">📄</span><span class="std-txt"><span class="std-nm">'+esc(s.n)+'</span><span class="std-ds">'+esc(s.d)+'</span></span></a>';
    }).join("")+'</div>';
  list.innerHTML=html;
  list.querySelectorAll(".mat-card[data-doc]:not(.locked)").forEach(function(c){
    c.addEventListener("click",function(){ openDoc(c.dataset.doc); });
  });
}
function openDoc(id){
  const d=DOCS[id]; if(!d)return;
  $("docTitle").textContent=d.icon+" "+d.name;
  $("docBody").innerHTML='<div class="paper">'+d.html+'</div>';
  $("docMask").classList.remove("hidden");
}

// ============ 渲染 ============
function currentStage(){
  const s = STEPS[current];
  if (!s) return 0;
  return (s.stage !== undefined && s.stage !== null) ? s.stage : LEVELS[levelIdx].stage;
}
function renderGuideBar(s){
  const bar = $("guideBar");
  if (!bar) return;
  const names = {ai:"AI 可以帮你", manual:"必须人工判断", quality:"行业素养要求"};
  const defs = [["ai",s.aiGuide],["manual",s.mustManual],["quality",s.quality]]
    .filter(function(d){ return d[1] && String(d[1]).trim(); });
  if (!defs.length){ bar.innerHTML = ""; bar.classList.add("hide"); return; }
  const rd = guideRead[s.id] || {};
  bar.innerHTML = defs.map(function(d){
    const isRead = !!rd[d[0]];
    return '<div class="guide-card '+d[0]+(isRead?" gd-read":" gd-collapsed")+'" data-k="'+d[0]+'">'+
      '<div class="gd-lb">'+GUIDE_ICONS[d[0]]+names[d[0]]+
        '<span class="gd-state '+(isRead?"read":"unread")+'">'+(isRead?"✓ 已读":"未读")+'</span></div>'+
      '<div class="gd-txt">'+esc(d[1])+'</div>'+
      (isRead?"":'<div class="gd-fold">👀 点击卡片展开阅读，读完计入作答解锁进度</div>')+
    '</div>';
  }).join("");
  bar.classList.remove("hide");
  bar.querySelectorAll(".guide-card").forEach(function(c){
    c.addEventListener("click", function(){
      const k = c.dataset.k;
      guideRead[s.id] = guideRead[s.id] || {};
      const first = !guideRead[s.id][k];
      guideRead[s.id][k] = true;
      c.classList.remove("gd-collapsed");
      c.classList.add("gd-read");
      const st = c.querySelector(".gd-state");
      if (st){ st.className = "gd-state read"; st.textContent = "✓ 已读"; }
      const fd = c.querySelector(".gd-fold"); if (fd) fd.remove();
      if (first) save();
      gateApply(s);
    });
  });
}
function gateNeed(s){
  const rd = guideRead[s.id] || {};
  const defs = [["ai",s.aiGuide],["manual",s.mustManual],["quality",s.quality]]
    .filter(function(d){ return d[1] && String(d[1]).trim(); });
  return { defs: defs, ready: defs.every(function(d){ return !!rd[d[0]]; }) };
}
function gateApply(s){
  const bar = $("gateBar"); if (!bar) return;
  const g = gateNeed(s);
  if (submitted || g.defs.length === 0){ bar.classList.add("hidden"); return; }
  if (g.ready){ bar.classList.add("hidden"); }
  else{
    const names = {ai:"AI 可以帮你", manual:"必须人工判断", quality:"行业素养要求"};
    const rd = guideRead[s.id] || {};
    const readN = g.defs.filter(function(d){ return !!rd[d[0]]; }).length;
    bar.classList.remove("hidden");
    bar.innerHTML = "🔒 作答区已锁定：引导卡已读 <b>"+readN+" / "+g.defs.length+"</b>。请依次点击查看「"+
      g.defs.map(function(d){ return names[d[0]]; }).join("」「")+"」，三张全部阅读完后开放作答。";
  }
  const lock = !g.ready;
  if (s.type === "table"){
    const b = $("btnTableSubmit"); if (b) b.disabled = lock;
    $("tableSlot").querySelectorAll(".tcell").forEach(function(i){ i.disabled = lock; });
  } else if (s.type === "plan"){
    const b = $("btnPlanGen"); if (b) b.disabled = lock;
  } else {
    const a = $("answerInput"); if (a) a.disabled = lock;
    const b = $("btnSubmit"); if (b) b.disabled = lock;
  }
}
function renderMap(){
  const row = $("stageRow");
  if (!row) return;
  row.innerHTML = "";
  const lv = LEVELS[levelIdx];
  const st = STAGES[lv.stage];
  let dots = "<div class='steps-dots'>";
  STEPS.forEach(function(s, i){
    let cls = "step-dot";
    if (records[i]) cls += " done";
    if (i === current) cls += " cur";
    // 始终显示关卡编号；已闯过的用右上角 ✓ 小角标标注，不再用对号替换数字
    dots += '<div class="' + cls + '" data-idx="' + i + '" title="第' + (i + 1) + '关 · ' + esc(s.title) + '">' + (i + 1) + (records[i] ? '<span class="step-badge">✓</span>' : '') + '</div>';
  });
  dots += "</div>";
  row.innerHTML =
    '<div class="stage-col active">' +
      '<div class="st-name">' +
        '<span class="st-dot" style="background:' + st.color + '"></span>' +
        esc(lv.name) +
        ' <small style="color:var(--dim);font-weight:500;margin-left:6px">大关卡 ' + (levelIdx + 1) + ' / ' + LEVELS.length + ' · 共 ' + STEPS.length + ' 步</small>' +
        '<button class="btn-mapinfo" id="btnStepMap" title="查看本大挑战每一关的内容说明">📋 关卡说明</button>' +
      '</div>' + dots +
      '<div style="font-size:11.5px;color:var(--dim);margin-top:6px">🖱️ 圆点数字 = 关卡编号，可任意点击选择，无需按顺序解锁；右上角带 ✓ 角标的为已闯过，点击可查看复盘并选择重新闯关</div>' +
    '</div>';
  row.querySelectorAll(".step-dot").forEach(function(d){
    d.addEventListener("click", function(){
      const i = +d.dataset.idx;
      if (records[i]) { openReview(i); }
      else if (i !== current) { goStep(i); }
    });
  });
  const bMap = $("btnStepMap");
  if (bMap) bMap.addEventListener("click", openStepMap);
}
// 自由选关：跳转到本大挑战内任意关卡（无需顺序解锁）
function goStep(i){
  if (i < 0 || i >= STEPS.length || i === current) return;
  current = i;
  submitted = !!records[i];
  save();
  renderStep();
  if (records[current]) renderFeedback(records[current], true);
  toast("已切换到第 " + (i + 1) + " 关：" + STEPS[i].title);
}
// 重新闯关：清除该关作答记录与得分，跳转过去重新作答
function redoStep(i){
  if (i < 0 || i >= STEPS.length) return;
  const r = records[i];
  if (r) { score -= (r.score || 0); delete records[i]; }
  submitted = false;
  current = i;
  save();
  renderStep();
  toast("已重置本关，开始重新闯关");
}
function renderTable(s){
  const t=s.table;
  let html=`<table class="tbl"><thead><tr>`;
  t.headers.forEach(h=>{ html+=`<th>${esc(h)}</th>`; });
  html+=`</tr></thead><tbody>`;
  t.rows.forEach((r,ri)=>{
    html+=`<tr><td class="tbl-label">${esc(r.label)}${r.prefill?`<span class="tbl-prefill">${esc(r.prefill)}</span>`:""}</td>`;
    html+=`<td>${r.editable===false?`<span class="tbl-prefill" style="margin:0;color:var(--dim)">${esc(r.prefill||"")}</span>`:`<input class="tcell" data-r="${ri}" placeholder="${esc(r.placeholder||"填写")}">`}</td>`;
    html+=`</tr>`;
  });
  html+=`</tbody></table>`;
  $("tableSlot").innerHTML=html;
}
function evaluateTable(s, values){
  const rows=s.table.rows.filter(r=>r.editable!==false);
  let hit=0;
  const detail=rows.map((r,ri)=>{
    const v=(values[ri]||"").trim();
    const t=norm(v);
    let ok;
    if(r.nums){
      const m=v.match(/\d+/g);
      const numHit = !!m && m.some(x=>r.nums.some(n=>x===String(n)));
      const kwHit = r.groups.some(g=>g.some(k=>t.includes(k)));
      ok = numHit || kwHit;
    }else{
      ok = r.any ? r.groups.some(g=>g.some(k=>t.includes(k))) : r.groups.every(g=>g.some(k=>t.includes(k)));
    }
    if(ok)hit++;
    return {label:r.label, answer:v, ok, expect:r.expect, good:r.good};
  });
  const ratio=rows.length?hit/rows.length:0;
  const stars=ratio>=0.75?3:ratio>=0.5?2:1;
  const score=Math.round(5*ratio);
  const verdict=stars===3?"判定优秀":stars===2?"判定良好":"需加强";
  const comment=stars===3?"张工：表格填写得很规范——"+hit+"/"+rows.length+" 格全部命中要点，材料读得很仔细。":stars===2?"张工：表格基本完成——"+hit+"/"+rows.length+" 格命中要点，对照「标准答案」把没填对的格子再记一遍。":"张工：表格填写还不完整——"+hit+"/"+rows.length+" 格命中要点。别急，先回到材料库把材料再读一遍，对照「标准答案」逐格订正——这正是练习的价值。";
  const ans=detail.map(d=>d.label+"："+(d.answer||"—")).join("；");
  return {stars,score,verdict,comment,detail,teach:s.teach,expect:s.expect,answer:ans};
}
function onSubmitTable(){
  const s=STEPS[current];
  if(!gateNeed(s).ready){toast("请先点击查看全部三张引导卡，阅读完成后才能作答");return;}
  const inputs=[...document.querySelectorAll(".tcell")];
  if(inputs.length===0)return;
  const values=inputs.map(i=>i.value);
  if(values.every(v=>!v.trim())){toast("请至少填写一个格子再提交");return;}
  const res=evaluateTable(s,values);
  if(records[current])score-=records[current].score;
  records[current]={type:"table",...res}; score+=res.score; submitted=true;
  save();
  updateProj();
  inputs.forEach(i=>i.disabled=true);
  $("btnTableSubmit").disabled=true;
  renderFeedback(records[current],false);
}

// ============ 测评方案生成器 ============
function recText(i){
  const r=records[i];
  if(!r)return null;
  if(r.detail){
    const lines=r.detail.map(d=>d.label+"："+(d.answer&&d.answer.trim()?d.answer:"—"));
    if(lines.length)return lines.join("<br>");
  }
  if(r.answer&&r.answer.trim())return esc(r.answer).replace(/\n/g,"<br>");
  return null;
}
function planChapters(){
  return [
    {name:"第一章 项目概述", src:1, src2:4, label:"项目信息认知表 + 定级报告信息提取"},
    {name:"第二章 测评依据", std:true},
    {name:"第三章 测评范围", src:9, label:"测评范围界定表"},
    {name:"第四章 测评对象", src:10, label:"测评对象选取表"},
    {name:"第五章 测评指标", src:11, label:"测评指标确定表"},
    {name:"第六章 测评方法", src:12, label:"测评方法作答"},
    {name:"第七章 日程安排与人员分工", src:13, label:"日程与人员分工表"},
    {name:"第八章 风险控制", src:14, label:"测评风险控制措施"}
  ];
}
function renderPlanIntro(s){
  const chs=planChapters();
  const si=STEPS.indexOf(s);
  const signed=(si>=0&&records[si]&&records[si].sign)?records[si].sign:null;
  let rows="";
  chs.forEach(function(c){
    const filled = c.std || !!recText(c.src);
    rows+='<div class="ps-row '+(filled?"ok":"miss")+'">'+
      '<span class="ps-ic">'+(filled?"✅":"⚠️")+'</span>'+
      '<span class="ps-name">'+esc(c.name)+'</span>'+
      '<span class="ps-src">'+(c.std?"标准内容自动补全":esc(c.label||""))+'</span>'+
      '<span class="ps-st">'+(filled?(c.std?"标准补全":"已按你的作答生成"):"将按标准参考补全")+'</span>'+
    '</div>';
  });
  $("planSlot").innerHTML=
    '<div class="plan-tip">'+(signed?('<b style="color:var(--green)">✅ 本方案已由你签字定稿（签署人：'+esc(signed.name)+'）。</b>'):'')+'方案编制六步法已走完。点击下方按钮，系统将把你在本挑战中的全部作答（信息认知表、定级信息提取、范围界定、对象选取、指标确定、测评方法、日程分工、风险控制）汇编成一份完整的《测评方案》——缺项将按标准参考自动补全。生成后可在线查看、下载留存。</div>'+
    '<div class="plan-status">'+rows+'</div>'+
    '<button class="btn-submit" id="btnPlanGen" style="width:100%;font-size:16px">📑 生成《测评方案》</button>';
  $("planSlot").classList.remove("hidden");
  $("btnPlanGen").addEventListener("click",onGenPlan);
}
